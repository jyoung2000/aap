# ==========================================================================
# JobPilot — environment configuration
# Copy to .env and adjust. `docker compose up` reads this file.
# The web app (UI + API + WebSocket) is ALWAYS served on port 1456.
# ==========================================================================

# ---- Core app ----
APP_NAME=JobPilot
APP_PORT=1456
# Public base URL the browser + extension use to reach the container.
# For local: http://localhost:1456  — for unraid: http://<server-ip>:1456
PUBLIC_BASE_URL=http://localhost:1456
# Comma-separated additional allowed origins for CORS (the app itself is same-origin).
EXTRA_CORS_ORIGINS=
# Secret used to sign sessions / CSRF tokens. CHANGE THIS. `openssl rand -hex 32`
SECRET_KEY=change-me-to-a-long-random-hex-string-please-really-do-it
# Set to "production" to enforce Secure cookies (requires HTTPS in front).
ENV=development
# Session lifetime (days)
SESSION_TTL_DAYS=30
# Where uploads, screenshots, and generated files live (a Docker volume is mounted here).
DATA_DIR=/data
# Seed the demo user + sample/live jobs on first boot (idempotent).
SEED_ON_START=true

# ---- Database (Postgres) ----
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full URL is derived from the pieces above by the app; override only if needed.
# DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@db:5432/jobpilot

# ---- Redis (queue + pub/sub) ----
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL=redis://redis:6379/0

# ---- LLM (Anthropic) — optional. Without it, JobPilot uses heuristic fallbacks. ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Max tokens for LLM completions
ANTHROPIC_MAX_TOKENS=2000

# ---- Job discovery aggregator keys (all optional) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
THEMUSE_API_KEY=
# Search-engine discovery: SerpAPI or Brave keys optional; falls back to DuckDuckGo HTML.
SERPAPI_KEY=
BRAVE_API_KEY=

# ---- Apply orchestration ----
# Global submission velocity cap (applications/hour) — applies in fast AND humanized modes.
MAX_APPLICATIONS_PER_HOUR=15
# Default for the per-user "Type like a human" toggle.
HUMANIZED_INPUT_DEFAULT=true
# Playwright server-side executor: run headful under Xvfb + noVNC for remote CAPTCHA solving.
PLAYWRIGHT_HEADLESS=false
NOVNC_PORT=6080
# Server-side executor mode: auto (try live browser, fall back to simulation) | live | simulate.
SERVER_EXECUTOR_MODE=auto
# Build-time: install the Chromium browser into the image for the live server executor.
# Off by default (leaner image). Set true and rebuild to enable no-browser Greenhouse/Lever applies.
INSTALL_BROWSERS=false

# ---- Notifications (optional) ----
# ntfy / Telegram-compatible webhook fired when a run pauses for human input.
NOTIFY_WEBHOOK_URL=
# SMTP for email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Extension ----
# Stamped into extension bundles so the popup can show an "update available" nudge.
EXTENSION_VERSION=1.0.0
